    <DrawingImage x:Key="EggArt">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H64 V64 H0 Z"/>
                <GeometryDrawing Brush="#142019" Geometry="M11,52 Q32,46 53,52 Q53,57 32,58 Q11,57 11,52 Z"/>

    <DataTemplate x:Key="DinoIdle">
        <Image Source="{StaticResource EggArt}" Stretch="Uniform" IsHitTestVisible="False"/>
    </DataTemplate>

    <DataTemplate x:Key="DinoLoading">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Grid x:Name="EggWobble" Width="64" Height="64" RenderTransformOrigin="0.5,0.75">
                <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                <Image Source="{StaticResource EggArt}"/>
                <Path x:Name="Crack" Stroke="#597348" StrokeThickness="2.3" StrokeLineJoin="Round"
                      Opacity="0.25" Data="M30,9 L26,19 L35,24 L29,32 L38,36 M35,24 L43,20"/>
            </Grid>
        </Viewbox>
        <DataTemplate.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Name="Cracking">
                            <Storyboard RepeatBehavior="Forever" Duration="0:0:1.65">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EggWobble" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="-7"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.48" Value="6"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.72" Value="-3"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crack" Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.20"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.52" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.20" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="0.20"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="FrameworkElement.Unloaded"><RemoveStoryboard BeginStoryboardName="Cracking"/></EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

